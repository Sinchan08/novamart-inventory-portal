<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <ViewSettingsDialog
        id="vsdProducts"
        confirm=".onConfirmViewSettings">
        
        <sortItems>
            <ViewSettingsItem id="vsiSortName" text="Product Name" key="name" selected="true"/>
            <ViewSettingsItem id="vsiSortPrice" text="Price" key="price"/>
            <ViewSettingsItem id="vsiSortStock" text="Stock Quantity" key="stock"/>
        </sortItems>

        <groupItems>
            <ViewSettingsItem id="vsiGroupCategory" text="Category" key="category"/>
        </groupItems>

        <filterItems>
            <ViewSettingsFilterItem
                id="vsfiCategory"
                text="Category"
                key="category"
                items="{
                    path: 'products>/categories',
                    templateShareable: false
                }">
                <items>
                    <ViewSettingsItem
                        id="vsiCategoryItem"
                        text="{products>text}"
                        key="{products>key}" />
                </items>
            </ViewSettingsFilterItem>
            <ViewSettingsFilterItem
                id="vsfiStockStatus"
                text="Stock Status"
                key="stock">
                <items>
                    <ViewSettingsItem id="vsiInStock" text="In Stock" key="In Stock"/>
                    <ViewSettingsItem id="vsiLowStock" text="Low Stock" key="Low Stock"/>
                    <ViewSettingsItem id="vsiOutOfStock" text="Out of Stock" key="Out of Stock"/>
                </items>
            </ViewSettingsFilterItem>
        </filterItems>
    </ViewSettingsDialog>
</core:FragmentDefinition>