<mvc:View
    controllerName="novamart.inventory.inventoryportal.controller.Detail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:form="sap.ui.layout.form">

    <f:DynamicPage
        id="detailPage"
        showFooter="true">

        <!-- Title / Header Bar -->
        <f:title>
            <f:DynamicPageTitle id="detailPageTitle">
                <f:heading>
                    <Title id="detailProductTitle" text="{products>name}" />
                </f:heading>
                
                <!-- TOP RIGHT: Close (X) Button -->
                <f:navigationActions>
                    <Button
                        id="btnCloseDetail"
                        icon="sap-icon://decline"
                        type="Transparent"
                        press=".onCloseDetailPress" />
                </f:navigationActions>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader id="detailPageHeader">
                <ObjectHeader
                    id="detailObjectHeader"
                    title="{products>name}"
                    number="{products>price}"
                    numberUnit="{products>currency}"
                    intro="SKU: {products>sku}">
                    <statuses>
                        <ObjectStatus
                            id="detailStockStatus"
                            text="{
                                path: 'products>stock',
                                formatter: '.formatter.formatStockStatusText'
                            }"
                            state="{
                                path: 'products>stock',
                                formatter: '.formatter.formatStockStatusState'
                            }" />
                    </statuses>
                    <attributes>
                        <ObjectAttribute id="attrCategory" text="{i18n>colCategory}: {products>category}" />
                        <ObjectAttribute id="attrWarehouse" text="{i18n>lblWarehouse}: {products>warehouse}" />
                        <ObjectAttribute id="attrSupplier" text="{i18n>lblSupplier}: {products>supplier}" />
                    </attributes>
                </ObjectHeader>
            </f:DynamicPageHeader>
        </f:header>

        <!-- Main Content Area -->
        <f:content>
            <VBox id="detailContentVBox" class="sapUiSmallMargin">
                <Panel id="detailSpecsPanel" headerText="{i18n>detailSectionTitle}">
                    <form:SimpleForm
                        id="detailSpecsForm"
                        editable="false"
                        layout="ColumnLayout">
                        <Label id="lblDescription" text="{i18n>lblDescription}" />
                        <Text id="txtDescription" text="{products>description}" />

                        <Label id="lblStockQuantity" text="{i18n>lblCurrentStock}" />
                        <Text id="txtStockQuantity" text="{products>stock}" />

                        <Label id="lblReorderThreshold" text="{i18n>lblReorderThreshold}" />
                        <Text id="txtReorderThreshold" text="{products>reorderThreshold}" />

                        <Label id="lblLastUpdated" text="{i18n>lblLastUpdated}" />
                        <Text id="txtLastUpdated" text="{products>lastUpdated}" />
                    </form:SimpleForm>
                </Panel>
            </VBox>
        </f:content>

        <!-- BOTTOM FOOTER BAR -->
        <f:footer>
            <OverflowToolbar id="detailFooterToolbar">
                <Button
                    id="btnReorderStock"
                    text="{i18n>btnReorder}"
                    icon="sap-icon://cart-plus"
                    type="Emphasized"
                    press=".onReorderPress" />
                <ToolbarSpacer id="detailFooterSpacer" />
                <Button
                    id="btnEditProduct"
                    text="{i18n>btnEdit}"
                    icon="sap-icon://edit"
                    type="Transparent"
                    press=".onEditPress" />
                <Button
                    id="btnDeleteProduct"
                    text="{i18n>btnDelete}"
                    icon="sap-icon://delete"
                    type="Reject"
                    press=".onDeletePress" />
            </OverflowToolbar>
        </f:footer>

    </f:DynamicPage>
</mvc:View>